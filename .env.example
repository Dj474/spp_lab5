# Порт шлюза (Apollo Gateway) и веб-приложения
PORT=4000

# Порты GraphQL-subgraph сервисов (распределённая архитектура / Federation)
CATALOG_PORT=4001
ORDERS_PORT=4002
ANALYTICS_PORT=4003

# Окружение: development | production
NODE_ENV=development

# Путь к файлу SQLite
DB_PATH=data/lab5.db
# Пересоздать базу при старте (true/false)
RESET_DB=false

# Логирование: debug | info | warn | error
LOG_LEVEL=info

# Контроль нагрузки (rate-limit): окно и максимум запросов к /graphql за окно
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX=5000

# Сбор данных из внешних источников
COLLECT_TIMEOUT_MS=6000
COLLECT_RETRIES=2
TARGET_USERS=800
TARGET_PRODUCTS=2000
TARGET_ORDERS=6000
TARGET_REVIEWS=8000
