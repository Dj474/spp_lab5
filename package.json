{
  "name": "lab5",
  "version": "1.0.0",
  "description": "Клиент-серверное приложение: backend и frontend общаются только через GraphQL",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:mut": "node scripts/test-mutations.mjs",
    "smoke:sub": "node scripts/test-subscription.mjs",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\""
  },
  "private": true,
  "dependencies": {
    "@apollo/gateway": "^2.14.4",
    "@apollo/server": "^4.13.0",
    "@apollo/subgraph": "^2.14.4",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.6.0"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
